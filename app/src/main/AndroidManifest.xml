<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET wird ausschließlich für den bewussten Download optionaler Stimmen (Piper-Modelle
         von GitHub, docs/PRIVACY.md) genutzt; danach läuft alles offline.
         VIBRATE (normal-level) für fühlbare Phasenwechsel. Ein Foreground-Service (mediaPlayback)
         hält den Meditations-Timer bei ausgeschaltetem Bildschirm zuverlässig am Laufen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Hält die CPU während einer laufenden Meditation wach: In tiefem Doze pausiert sonst der
         Timer-Loop und End-/Intervall-Gongs kämen (Minuten) zu spät. Nur aktiv, solange die
         Sitzung läuft; bei Pause/Ende sofort freigegeben. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sichtbarkeit der geräteeigenen Text-to-Speech-Engine (Package-Visibility ab Android 11),
         für die optionale gesprochene Meditations-Anleitung; sie erhält nur feste Ansagetexte. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AtemkraftApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atemkraft">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Atemkraft">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.meditation.MeditationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
