<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Schlanke Basis-Theme nur für das Start-Fenster; die eigentlichen Farben
         setzt das Compose-Theme (AtemkraftTheme). DayNight via values-night. -->
    <style name="Theme.Atemkraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
