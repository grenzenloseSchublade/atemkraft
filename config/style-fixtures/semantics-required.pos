Modifier.clickable { open() }
Modifier.clickable(onClick = open)
Modifier.clickable(
    interactionSource = remember { MutableInteractionSource() },
    onClick = open,
)
Surface(onClick = open, color = c) { Text(t) }
Surface(
    onClick = open,
    modifier = modifier.fillMaxWidth().heightIn(min = h),
) { Text(t) }
