#!/usr/bin/env bash
# Vor dem Push: Commit-Betreffs je Commit und guide-sync über den ganzen Bereich (PROZ-01, PROZ-02),
# wie der CI-Job „conventions“. Danach lässt sich ein falscher Betreff noch ohne Force-Push ändern.
# Die vollen Prüfungen (scripts/check.sh) laufen im CI; lokal vorher von Hand.
# Einrichten (einmal je Klon): git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
# Ohne Upstream (neuer Branch) gegen origin/main prüfen; ohne origin (frischer Klon ohne Remote) mit Hinweis durchlassen.
if UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
  RANGE="${UPSTREAM}..HEAD"
elif git rev-parse --verify --quiet origin/main >/dev/null; then
  RANGE="origin/main..HEAD"
else
  echo "pre-push: kein Upstream und kein origin/main – Bereich nicht bestimmbar, prüfe von Hand: scripts/check-style.sh --ci-range <basis>..HEAD" >&2
  exit 0
fi
exec "${ROOT}/scripts/check-style.sh" --ci-range "${RANGE}"
