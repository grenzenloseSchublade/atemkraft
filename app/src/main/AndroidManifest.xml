<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimal: kein Internet, kein Foreground-Service – alles läuft offline.
         Einzige Permission: VIBRATE (normal-level, harmlos) für fühlbare Phasenwechsel,
         die auch bei ausgeschalteter System-Tipp-Haptik funktionieren. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".AtemkraftApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atemkraft">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Atemkraft">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
