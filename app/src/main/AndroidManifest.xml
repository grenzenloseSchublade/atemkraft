<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET wird ausschließlich für den bewussten Download optionaler Stimmen (Piper-Modelle
         von GitHub, docs/PRIVACY.md) genutzt; danach läuft alles offline.
         VIBRATE (normal-level) für fühlbare Phasenwechsel. Ein Foreground-Service (mediaPlayback)
         hält Meditation und Atemübung bei ausgeschaltetem Bildschirm zuverlässig am Laufen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Hält die CPU während einer laufenden Meditation oder Atemübung wach: In tiefem Doze
         pausiert sonst der Timer-Loop und Gongs bzw. Phasen-Töne kämen (Minuten) zu spät. Nur aktiv, solange die
         Sitzung läuft; bei Pause/Ende sofort freigegeben. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nur für die lokale Erinnerung (aus ab Werk): Der JobScheduler behält den geplanten Job über
         einen Neustart nur mit dieser Berechtigung (JobInfo.setPersisted). Die App hat dafür keinen
         eigenen Receiver; ohne sie hörte die Erinnerung nach jedem Neustart still auf, bis die App
         wieder geöffnet wird (docs/DECISIONS.md, 2026-10-24). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Sichtbarkeit der geräteeigenen Text-to-Speech-Engine (Package-Visibility ab Android 11),
         für die optionale gesprochene Meditations-Anleitung; sie erhält nur feste Ansagetexte. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- hasFragileUserData (ab Android 10): Beim Deinstallieren bietet Android an, Logbuch und
         Muster zu behalten; bei einer Neuinstallation mit derselben Signatur sind sie wieder da.
         Bleibt auf dem Gerät, ohne Cloud (docs/PRIVACY.md, „Deinstallieren“). -->
    <application
        android:name=".AtemkraftApplication"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atemkraft">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Atemkraft">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App-Shortcuts (Long-Press auf das Icon): explizite Intents mit fester Aktion, kein
                 eigener Intent-Filter, keine <data> (SEC-PLAT-02). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Lokale Erinnerung: nur der JobScheduler des Systems bindet ihn (BIND_JOB_SERVICE),
             nicht exportiert; kein Netz, kein exakter Wecker. -->
        <service
            android:name=".playback.ReminderJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
