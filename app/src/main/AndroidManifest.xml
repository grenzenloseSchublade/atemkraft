<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET wird ausschließlich für den bewussten, einmaligen Download des optionalen
         hochwertigen Sprachmodells (Piper „Thorsten") genutzt; danach läuft alles offline.
         VIBRATE (normal-level) für fühlbare Phasenwechsel. Ein Foreground-Service (mediaPlayback)
         hält den Meditations-Timer bei ausgeschaltetem Bildschirm zuverlässig am Laufen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sichtbarkeit der geräteeigenen Text-to-Speech-Engine (Package-Visibility ab Android 11),
         für die optionale gesprochene Meditations-Anleitung. Läuft lokal/offline. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AtemkraftApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atemkraft">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Atemkraft">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.meditation.MeditationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
